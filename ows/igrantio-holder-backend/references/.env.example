# --- iGrant.io holder backend ---
PORT=6003

# Environment: demo (default) | staging | production. The integrator decides.
# The API key must belong to the same environment.
OWS_ENV=demo
# Optional override of the API base URL. Leave it unset to use the OWS_ENV
# mapping (demo -> https://demo-api.igrant.io,
# staging -> https://staging-api.igrant.io, production -> https://api.igrant.io).
# OWS_BASE_URL=

# Comma-separated allowed browser origins. Empty = reflect any origin (only for local development).
CORS_ORIGINS=http://localhost:3000,https://wallet-portal.example.com

# Proxy mount path. The frontend base becomes ${PROXY_PREFIX}/${tenant}, for example /ows/acme
PROXY_PREFIX=/ows

UPSTREAM_TIMEOUT_MS=120000

# --- OWS API key of each tenant ---
# One for each organisation: OWS_TENANT_<SLUG>_API_KEY (slug upper-cased, non-alphanumerics -> _)
OWS_TENANT_ACME_API_KEY=your-acme-api-key
